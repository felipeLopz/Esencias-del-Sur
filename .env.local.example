# Copiá este archivo como .env.local y completá los valores.
# .env*.local está en .gitignore: nunca se sube al repo.

# --- Base de datos (Neon Postgres, proyecto "esencias-del-sur") ---
# Guarda SOLO el stock (disponible/agotado por slug). Nombre, precio,
# descripción, imagen, género y categoría siguen en data/productos.ts.
# La connection string sale de: Neon console -> esencias-del-sur ->
# Connection Details (o del dashboard de Vercel, donde está el recurso).
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# --- Panel /admin ---
# PIN de 6 dígitos para entrar al panel de stock.
APP_PIN=211211

# Secreto con el que se firma la cookie de sesión del panel (HMAC-SHA256).
# NO es el PIN. Generá uno propio con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Si lo rotás, se cierran todas las sesiones abiertas del panel.
SESSION_SECRET=<64 caracteres hex al azar>
